# HopBaleCount - optional environment variables.
# Nothing here is required: `cp .env.example .env` followed by the documented
# run command boots with zero edits, and so does running with no .env at all.
# The tool does not read dotenv files; export these in your shell if you want them.

# Path to the JSON data store (default: hopbales.json in the current directory).
HOPBALECOUNT_DATA_FILE=hopbales.json

# Passphrase for non-interactive/scripted runs. Leave empty to be prompted
# (hidden, via getpass). No passphrase is ever stored when this is empty.
HOPBALECOUNT_PASSPHRASE=

# Set to any non-empty value to suppress the accent colour in table rules.
NO_COLOR=
